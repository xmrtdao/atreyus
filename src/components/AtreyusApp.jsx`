import React, { useState, useEffect } from 'react';
import { Upload, Plus, Save, FileText, Layout, Sparkles, Square, Download, Trash2 } from 'lucide-react';
import { cn } from '../lib/cn.js';
import PlanCanvas from './PlanCanvas.jsx';
import Inspector from './Inspector.jsx';
import BomPanel from './BomPanel.jsx';
import { emptySheet, loadAll, saveAll, computeBom, downloadJson } from '../takeoff/model.js';
import { mapDetections } from '../takeoff/ai.js';

const PLANS = [
  { id: 'plan1-studio', label: 'Plan 1 · Studio', sheet: 'A1-111' },
  { id: 'plan2-2bed', label: 'Plan 2 · 2 bed', sheet: 'A2-111' },
  { id: 'plan3-2bed', label: 'Plan 3 · 2 bed', sheet: 'A3-111' },
  { id: 'plan4-3bed', label: 'Plan 4 · 3 bed', sheet: 'A4-111' },
];

export default function AtreyusApp() {
  const [sheets, setSheets] = useState({});
  const [activePlan, setActivePlan] = useState(null);
  const [selectedId, setSelectedId] = useState(null);
  const [draftMode, setDraftMode] = useState(null);
  const [aiStatus, setAiStatus] = useState('idle');
  const [aiMsg, setAiMsg] = useState('');

  useEffect(() => {
    setSheets(loadAll());
  }, []);

  useEffect(() => {
    saveAll(sheets);
  }, [sheets]);

  const sheet = activePlan ? (sheets[activePlan.id] ?? emptySheet(activePlan.id)) : null;

  const updateSheet = (update) => {
    if (!activePlan) return;
    setSheets(prev => ({
      ...prev,
      [activePlan.id]: { ...(prev[activePlan.id] ?? emptySheet(activePlan.id)), ...update, updatedAt: Date.now() },
    }));
  };

  const addDetection = (x, y) => {
    const det = {
      id: `usr_${Date.now().toString(36)}`,
      type: 'light-recessed',
      confidence: 1,
      x, y, source: 'user', roomId: null,
    };
    updateSheet({ detections: [...(sheet.detections ?? []), det] });
    setSelectedId(det.id);
  };

  const updateDetection = (id, patch) => {
    updateSheet({ detections: (sheet.detections ?? []).map(d => d.id === id ? { ...d, ...patch } : d) });
  };

  const moveDetection = (id, x, y) => updateDetection(id, { x, y });

  const deleteDetection = (id) => {
    updateSheet({ detections: (sheet.detections ?? []).filter(d => d.id !== id) });
    setSelectedId(null);
  };

  const addRoom = (r) => updateSheet({ rooms: [...(sheet.rooms ?? []), r] });

  const runAi = async () => {
    if (!activePlan) return;
    setAiStatus('working');
    setAiMsg('Contacting AI server...');
    try {
      const res = await fetch(`/api/takeoff?plan=${activePlan.id}`);
      if (!res.ok) throw new Error(`backend ${res.status}`);
      const data = await res.json();
      const dets = mapDetections(data.detections, data.imageWidth, data.imageHeight, activePlan.id);
      updateSheet({ detections: dets });
      setAiStatus('ok');
      setAiMsg(`${dets.length} detections from AI`);
    } catch (e) {
      setAiStatus('fail');
      setAiMsg(`AI backend unavailable (${e.message}) — review mode still works: draw rooms, add markers.`);
    }
  };

  const uploadPdf = async (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    setAiStatus('working');
    setAiMsg('Analyzing PDF…');
    try {
      const fd = new FormData();
      fd.append('file', file);
      const res = await fetch('/api/takeoff/upload', { method: 'POST', body: fd });
      if (!res.ok) throw new Error(`backend ${res.status}`);
      const data = await res.json();
      const planId = data.planId ?? 'upload';
      setActivePlan({ id: planId, label: file.name, sheet: 'upload' });
      setSheets(prev => ({
        ...prev,
        [planId]: { ...emptySheet(planId), planUrl: data.planUrl, detections: mapDetections(data.detections, data.imageWidth, data.imageHeight, planId) },
      }));
      setAiStatus('ok');
      setAiMsg(`${data.detections?.length ?? 0} detections`);
    } catch (e) {
      setAiStatus('fail');
      setAiMsg(`Upload failed (${e.message})`);
    }
  };

  const bom = sheet ? computeBom(sheet.detections ?? [], sheet.rooms ?? []) : null;
  const selected = sheet?.detections?.find(d => d.id === selectedId) ?? null;

  return (
    <div className="flex h-screen bg-slate-900 text-slate-100 font-sans">
      <div className="w-80 bg-slate-800 border-r border-slate-700 flex flex-col">
        <div className="p-5 border-b border-slate-700 flex items-center gap-3">
          <Layout className="text-blue-400" size={22} />
          <div>
            <h1 className="text-xl font-bold tracking-tight">Atreyus Takeoff</h1>
            <p className="text-[10px] text-slate-400 uppercase tracking-widest">Electrical · Escondido PAADU</p>
          </div>
        </div>
        <div className="p-5 space-y-5 overflow-y-auto flex-1">
          <section>
            <label className="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Sheets</label>
            <div className="grid grid-cols-1 gap-1.5">
              {PLANS.map(p => (
                <button
                  key={p.id}
                  onClick={() => { setActivePlan(p); setSelectedId(null); }}
                  className={cn(
                    'px-3 py-2 rounded-lg text-left text-sm border transition-colors flex items-center justify-between',
                    activePlan?.id === p.id ? 'border-blue-500 bg-blue-600/20 text-white' : 'border-slate-600/50 bg-slate-700/40 text-slate-300 hover:border-slate-500'
                  )}
                >
                  <span>{p.label}</span>
                  <span className="text-[10px] text-slate-400">{p.sheet}</span>
                </button>
              ))}
            </div>
            <div className="flex gap-2 mt-2">
              <label className="flex-1 cursor-pointer px-3 py-2 rounded-lg text-xs border border-dashed border-slate-600 text-slate-400 hover:border-blue-500 hover:text-blue-300 text-center">
                <Upload size={13} className="inline mr-1" /> Upload PDF
                <input type="file" className="hidden" accept=".pdf" onChange={uploadPdf} />
              </label>
              <button
                onClick={runAi}
                disabled={!activePlan || aiStatus === 'working'}
                className="px-3 py-2 rounded-lg text-xs bg-violet-600/30 border border-violet-500/50 text-violet-200 hover:bg-violet-600/50 disabled:opacity-40"
                title="Run AI detection via backend on this sheet"
              >
                <Sparkles size={13} className="inline mr-1" /> Run AI
              </button>
            </div>
            {aiMsg && (
              <p className={cn('text-[11px] mt-2', aiStatus === 'fail' ? 'text-amber-400' : 'text-emerald-400')}>{aiMsg}</p>
            )}
          </section>
          <section>
            <label className="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Tools</label>
            <div className="grid grid-cols-2 gap-1.5">
              <button
                onClick={() => setDraftMode(m => m === 'add' ? null : 'add')}
                className={cn('px-3 py-2 rounded-lg text-xs border flex items-center gap-1.5',
                  draftMode === 'add' ? 'border-blue-400 bg-blue-600/30 text-white' : 'border-slate-600 bg-slate-700/40 text-slate-300')}
              >
                <Plus size={13} /> Add marker
              </button>
              <button
                onClick={() => setDraftMode(m => m === 'room' ? null : 'room')}
                className={cn('px-3 py-2 rounded-lg text-xs border flex items-center gap-1.5',
                  draftMode === 'room' ? 'border-emerald-400 bg-emerald-600/30 text-white' : 'border-slate-600 bg-slate-700/40 text-slate-300')}
              >
                <Square size={13} /> Draw room
              </button>
              <button
                onClick={() => { if (activePlan) downloadJson(sheet, `${activePlan.id}-takeoff.json`); }}
                disabled={!activePlan}
                className="px-3 py-2 rounded-lg text-xs border border-slate-600 bg-slate-700/40 text-slate-300 disabled:opacity-40 flex items-center gap-1.5"
              >
                <Download size={13} /> Export JSON
              </button>
              <button
                onClick={() => { if (activePlan) setSheet({ detections: [], rooms: [] }); }}
                disabled={!activePlan}
                className="px-3 py-2 rounded-lg text-xs border border-red-500/40 bg-red-500/10 text-red-300 disabled:opacity-40 flex items-center gap-1.5"
              >
                <Trash2 size={13} /> Clear sheet
              </button>
            </div>
          </section>
          {bom && <BomPanel roomRows={bom.roomRows} totals={bom.totals} />}
        </div>
        <div className="p-5 border-t border-slate-700 bg-slate-800/50">
          <button className="w-full py-3 bg-blue-600 hover:bg-blue-500 text-white rounded-xl font-semibold flex items-center justify-center gap-2"
            onClick={() => { if (activePlan) downloadJson(sheet, `${activePlan.id}-takeoff.json`); }}>
            <Save size={17} /> Export takeoff
          </button>
        </div>
      </div>

      <div className="flex-1 relative overflow-hidden flex flex-col">
        {draftMode && (
          <div className="absolute top-5 left-1/2 -translate-x-1/2 z-30 bg-blue-600 text-white text-xs px-4 py-2 rounded-full shadow-lg">
            {draftMode === 'add' && 'Click the plan to place a marker · ESC to cancel'}
            {draftMode === 'room' && 'Drag a rectangle to define a room · ESC to cancel'}
          </div>
        )}
        {activePlan ? (
          <>
            <PlanCanvas
              key={activePlan.id}
              planUrl={sheet?.planUrl ?? `/plans/${activePlan.id}.png`}
              sheet={{ ...sheet, planUrl: sheet?.planUrl ?? `/plans/${activePlan.id}.png` }}
              draftMode={draftMode}
              setDraftMode={setDraftMode}
              selectedId={selectedId}
              onAdd={addDetection}
              onSelect={setSelectedId}
              onMove={moveDetection}
              onRoomUpdate={addRoom}
            />
            {selected && (
              <Inspector
                det={selected}
                rooms={sheet.rooms ?? []}
                onUpdate={(patch) => updateDetection(selected.id, patch)}
                onDelete={deleteDetection}
                onClose={() => setSelectedId(null)}
              />
            )}
          </>
        ) : (
          <div className="flex flex-col items-center justify-center h-full text-slate-600 gap-4">
            <FileText size={64} strokeWidth={1} />
            <p className="text-xl">Select a sheet to begin the takeoff</p>
            <p className="text-sm text-slate-700">Plans 1–4 · City of Escondido PAADU</p>
          </div>
        )}
      </div>
    </div>
  );
}
